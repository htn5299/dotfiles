#!/usr/bin/env bash
set -e

echo "==> 1. Downloading Kanata binary..."
curl -sL https://github.com/jtroo/kanata/releases/latest/download/kanata -o /tmp/kanata
sudo install -m 755 /tmp/kanata /usr/local/bin/kanata
rm -f /tmp/kanata

echo "==> 2. Setting up uinput & permissions..."
sudo groupadd -f uinput
sudo usermod -aG input,uinput "$USER"

sudo tee /etc/udev/rules.d/99-kanata.rules > /dev/null << 'RULE'
KERNEL=="uinput", MODE="0660", GROUP="uinput", OPTIONS+="static_node=uinput"
SUBSYSTEM=="input", MODE="0660", GROUP="input"
RULE

echo "uinput" | sudo tee /etc/modules-load.d/uinput.conf > /dev/null
sudo modprobe uinput
sudo udevadm control --reload && sudo udevadm trigger

echo "==> 3. Enabling Kanata systemd service..."
mkdir -p ~/.config/systemd/user
cat << 'SERVICE' > ~/.config/systemd/user/kanata.service
[Unit]
Description=Kanata keyboard remapper
Documentation=https://github.com/jtroo/kanata

[Service]
Type=simple
ExecStart=/usr/local/bin/kanata --cfg %h/.config/kanata/kanata.kbd
Restart=always
RestartSec=3

[Install]
WantedBy=default.target
SERVICE

systemctl --user daemon-reload
systemctl --user enable --now kanata.service

echo "==> Kanata setup complete! You may need to relogin for group permissions to take full effect."
