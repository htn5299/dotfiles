# Kanata configuration for ThinkPad & external keyboards
# Caps -> tap=Esc, hold=Meta (Super)
# Tab  -> tap=Tab, hold=Arrows layer (hjkl)

(defcfg
  process-unmapped-keys yes
  linux-dev-names-include (
    "AT Translated Set 2 keyboard"
    "MCHOSE Ace 60 Pro"
  )
)

(defsrc
  tab
  caps h j k l
  ralt
)

(deflayer default
  @tab
  @cap _ _ _ _
  caps
)

(deflayer arrows
  _
  _ left down up rght
  _
)

(defalias
  cap (tap-hold-press 200 200 esc lmet)
  tab (tap-hold-press 200 200 tab (layer-toggle arrows))
)
