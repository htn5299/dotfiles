{
  "layer": "top",
  "position": "left",
  "width": 40,
  "reload_style_on_change": true,
  "modules-left": [
    "niri/workspaces"
  ],
  "modules-right": [
    "custom/tomat",
    "tray",
    "pulseaudio",
    "idle_inhibitor",
    "battery",
    "clock"
  ],
  "niri/workspaces": {
    "all-outputs": false,
    "cursor": true
  },
  "tray": {
    "icon-size": 16,
    "spacing": 20,
    "cursor": true
  },
  "idle_inhibitor": {
    "format": "{icon}",
    "format-icons": {
      "activated": "󰅶",
      "deactivated": "󰾪"
    },
    "tooltip-format-activated": "Idle inhibit: on",
    "tooltip-format-deactivated": "Idle inhibit: off"
  },
  "clock": {
    "interval": 60,
    "tooltip": true,
    "format": "{:%H\n%M}",
    "justify": "center",
    "on-click": "swaync-client -t",
    "tooltip-format": "{:%d-%m-%Y}"
  },
  "battery": {
    "states": {
      "good": 90,
      "warning": 20,
      "critical": 10
    },
    "format": "{icon}",
    "format-charging": "󱐋\n{icon}",
    "justify": "center",
    "format-icons": [
      "󰁻",
      "󰁼",
      "󰁾",
      "󰂀",
      "󰂂",
      "󰁹"
    ],
    "tooltip-format": "{timeTo} {capacity} % | {power} W"
  },
  "custom/tomat": {
    "format": "{text}",
    "tooltip": true,
    "return-type": "json",
    "interval": 1,
    "justify": "center",
    "on-click": "tomat toggle",
    "on-click-right": "tomat skip",
    "exec-if": "which tomat",
    "exec": "tomat status | jq -c '.text |= sub(\":\"; \"\\n\")'"
  },
  "pulseaudio": {
    "format": "{icon}",
    "tooltip-format": "{volume}% {icon} | {desc}",
    "format-icons": {
      "default": [
        "󰕿",
        "󰖀",
        "󰕾"
      ],
      "default-muted": "󰝟",
      "headphone": "󰋋",
      "headphone-muted": "󰟎",
      "headset": "󰋋",
      "headset-muted": "󰟎"
    },
    "on-click": "wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle",
    "on-click-right": "pwvucontrol"
  }
}
